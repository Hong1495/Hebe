{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Hebe",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:scope-appdata-recursive",
    "store:default",
    "window-state:default",
    "clipboard-manager:default",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-write-image"
  ]
}
