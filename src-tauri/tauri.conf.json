{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hebe",
  "version": "1.1.0",
  "identifier": "app.hebe.markdown",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Hebe",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 19,
          "y": 28
        },
        "hiddenTitle": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mkdn"],
        "name": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown",
        "rank": "Default",
        "contentTypes": ["net.daringfireball.markdown"]
      },
      {
        "ext": ["mdx"],
        "name": "MDX Document",
        "role": "Editor",
        "mimeType": "text/markdown",
        "rank": "Default",
        "exportedType": {
          "identifier": "app.hebe.mdx",
          "conformsTo": ["public.text", "public.data"]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
